# n8n — Environment Variables
# Copy this file to .env and customize as needed
# Used by docker-compose.yml

# === Database ===
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=n8n_password
POSTGRES_PORT=5432

# === Redis ===
REDIS_PORT=6379

# === n8n Image ===
# The Docker image to use for n8n services
N8N_IMAGE=n8n-custom:latest

# === n8n Server ===
N8N_PORT=5678
N8N_HOST=0.0.0.0
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/

# === Security ===
# IMPORTANT: Change this to a random string in production!
N8N_ENCRYPTION_KEY=change-me-to-a-random-string

# === Timezone ===
GENERIC_TIMEZONE=Asia/Ho_Chi_Minh
TZ=Asia/Ho_Chi_Minh

# === Logging ===
N8N_LOG_LEVEL=info

# === Metrics & Diagnostics ===
N8N_METRICS=true
N8N_DIAGNOSTICS_ENABLED=false

# === Worker Settings ===
QUEUE_WORKER_TIMEOUT=60
QUEUE_WORKER_STALLED_INTERVAL=30000
